<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" radius="${lidar_radius}" length="${lidar_length}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${base_length/2 - lidar_radius} 0 ${base_height/2 + lidar_length/2}" rpy="0 0 3.141592653589793"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${camera_size} 0.1 ${camera_size}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_size} 0.1 ${camera_size}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="${camera_size}" y="0.1" z="${camera_size}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2 + 0.01} 0 ${base_height/2 + 0.08}" rpy="0 0 0"/>
  </joint>
  
  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  
  <gazebo reference="camera_link">
    <material>Gazebo/Red</material>
  </gazebo>

</robot>
