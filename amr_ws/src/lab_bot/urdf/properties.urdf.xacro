<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.45" />
  <xacro:property name="base_width" value="0.32" />
  <xacro:property name="base_height" value="0.12" />
  <xacro:property name="base_mass" value="5.0" />

  <xacro:property name="wheel_radius" value="0.08" />
  <xacro:property name="wheel_thickness" value="0.03" />
  <xacro:property name="wheel_mass" value="0.5" />
  <xacro:property name="wheel_offset_x" value="-0.10" /> 
  <xacro:property name="wheel_offset_y" value="${base_width/2 + wheel_thickness/2}" />
  <xacro:property name="wheel_offset_z" value="-0.04" />

  <xacro:property name="caster_radius" value="0.04" />
  <xacro:property name="caster_mass" value="0.2" />
  <xacro:property name="caster_offset_x" value="0.16" /> <xacro:property name="caster_offset_z" value="-0.08" /> 

  <xacro:property name="lidar_radius" value="0.04" />
  <xacro:property name="lidar_length" value="0.04" />
  <xacro:property name="camera_size" value="0.03" />
</robot>